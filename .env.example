# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI in the app settings (Spotify requires 127.0.0.1, not "localhost"):
#   http://127.0.0.1:3000/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDIRECT_URI=http://127.0.0.1:3000/callback
PORT=3000
# How often to pull new plays (seconds). Spotify only keeps your last 50, so keep this under ~1 hour.
POLL_SECONDS=60
